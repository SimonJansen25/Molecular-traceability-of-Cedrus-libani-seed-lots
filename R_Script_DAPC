# --- 6.2 Within-West DAPC ---
ref_west <- ref_common[as.character(pop(ref_common)) %in% west_pops, ]
blind_west_lots <- lot_assignments_ew |> filter(assigned == "West") |> pull(lot)
blind_west <- blind_common[as.character(pop(blind_common)) %in% blind_west_lots, ]

set.seed(42)
ref_xval_west <- xvalDapc(
  tab(ref_west, NA.method = "mean"),
